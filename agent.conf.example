; ─────────────────────────────────────────────────────────────────────────────
;  Heimdall Agent — fichier de configuration
;
;  Copiez ce fichier en « agent.conf » dans le même dossier que l'agent, puis
;  renseignez vos valeurs. Ne committez JAMAIS votre agent.conf (il contient
;  des secrets) — il est ignoré par .gitignore.
;
;  Emplacements recherchés automatiquement :
;    - <dossier de l'agent>/agent.conf
;    - /opt/heimdall-agent/agent.conf        (Linux)
;    - C:\ProgramData\HeimdallAgent\agent.conf (Windows)
; ─────────────────────────────────────────────────────────────────────────────

[main_server]
; Hôte / IP du serveur agent Heimdall (celui que vous déployez avec docker compose)
host = 127.0.0.1
; Port du serveur agent (défaut : 4000)
port = 4000
; Doit correspondre à AGENT_AUTH_TOKEN défini côté serveur agent.
; Générez-en un fort, par ex. : python -c "import secrets; print(secrets.token_hex(32))"
token = changeme-secret-token
; Connexion chiffrée au serveur (true/false) et vérification de son certificat.
; verify_ssl = false accepte un certificat auto-signé (déconseillé hors réseau interne).
use_https = false
verify_ssl = true
; NB : la clé API CVE n'est PAS configurée sur les agents. Elle se définit uniquement
; côté serveur agent (variable CVE_API_KEY).

[agent]
; Intervalle en minutes entre deux envois en mode démon
interval_minutes = 60
; Activer le scan de ports à chaque collecte (true/false)
port_scan = false
; Vérification des logiciels à mettre à jour (winget / apt / dnf / yum / zypper / brew).
; Intervalle en heures entre deux vérifications (0 = désactivée).
update_check_hours = 6

[ui]
; Windows uniquement — apparence de l'agent : dark | light | auto (suit le thème Windows)
theme = dark

[dashboard]
; URL publique du frontend CVE (ex : http://localhost:3000 ou https://cve.mon-domaine.com)
; Utilisée pour générer les liens vers les pages de détail CVE.
frontend_url = http://localhost:3000
